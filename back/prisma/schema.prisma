generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int              @id @default(autoincrement())
  email        String           @unique
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions     WorkoutSession[]
  history      WorkoutHistory[]
}

model WorkoutSession {
  id         Int        @id @default(autoincrement())
  name       String
  favorite   Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  userId     Int
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises  Exercise[]
  history     WorkoutHistory[]

  @@index([userId])
}

model Exercise {
  id         Int           @id @default(autoincrement())
  name       String
  orderIndex Int
  sessionId  Int
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sets       ExerciseSet[]

  @@index([sessionId])
  @@index([sessionId, orderIndex])
}

model ExerciseSet {
  id         Int      @id @default(autoincrement())
  type       String
  time       Int
  wait       Int
  weight     Float    @default(0)
  orderIndex Int
  exerciseId Int
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
  @@index([exerciseId, orderIndex])
}

model WorkoutHistory {
  id                 Int             @id @default(autoincrement())
  userId             Int
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId          Int?
  session            WorkoutSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessionName        String
  durationSeconds    Int
  exercisesCompleted Int             @default(0)
  setsCompleted      Int             @default(0)
  finishedAt         DateTime        @default(now())

  @@index([userId, finishedAt])
  @@index([sessionId])
}
